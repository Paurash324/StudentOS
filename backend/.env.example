# StudentOS Backend Environment Configuration
# Copy this file to .env and fill in your values.
# IMPORTANT: .env is excluded from Git. Never commit real credentials.

# Groq API Configuration
# Get your free API key at: https://console.groq.com/keys
# Required: A valid Groq API key for AI chat and quiz generation.
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Selection
# Options: openai/gpt-oss-120b, llama-3.3-70b-versatile, qwen/qwen3.8-27b, llama-3.1-8b-instant
# Default: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# CORS Allowed Origins (comma-separated)
# Set to your frontend domain in production, e.g.:
#   - https://your-app.onrender.com
#   - https://studentos.example.com
# For local development, keep http://localhost:5173 and http://127.0.0.1:5173
# Default allows all origins in development (use ALLOWED_ORIGINS env var in production).
# ALLOWED_ORIGINS=https://your-frontend.onrender.com,https://your-app.example.com

