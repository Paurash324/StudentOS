# StudentOS Frontend Environment Configuration
# Copy this file to .env.local for local development overrides.
# IMPORTANT: .env and .env.local are excluded from Git. Never commit real credentials.
#
# Vite only exposes environment variables prefixed with VITE_ to the client.
# See: https://vite.dev/guide/env-and-mode

# API Base URL for production deployment
# Set this to your deployed backend URL, e.g.:
#   VITE_API_BASE_URL=https://studentos-backend.onrender.com
#
# Leave unset for local development - Vite's dev server proxy will forward
# /api requests to the backend at http://127.0.0.1:8000
# VITE_API_BASE_URL=https://your-backend.onrender.com
